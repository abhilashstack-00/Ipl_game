# Backend port provided by your host (Render sets PORT automatically)
PORT=3002

# Comma-separated list of allowed frontend origins
# Example: FRONTEND_URLS=https://yourname.github.io/ipl-game,http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# REQUIRED. The server refuses to start without it (there is no fallback).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Optional live match provider (set to cricapi to enable live sync)
LIVE_MATCH_PROVIDER=

# API key for CricAPI when LIVE_MATCH_PROVIDER=cricapi
CRICAPI_KEY=

# Optional filter for series/name matching in provider payload
LIVE_SERIES_FILTER=ipl

# Poll cache window in milliseconds for live provider responses
# Lower values apply results faster but increase API calls
LIVE_CACHE_MS=15000

# Enable test-only helpers like auto-seeding a session for auction bypass.
# Keep false in production.
ALLOW_TEST_HELPER=false

# Admins can enter official results when the live feed has none. Two ways to make one:
#   1. ADMIN_USERNAMES below: comma-separated, exact case. Applied at startup to existing users
#      and at registration to new ones. Use this on Render's free tier (no shell, DB is wiped on restart).
#      It only grants admin; removing a name does not demote an existing user.
#   2. node setup.js --admin <username>   (needs shell access to the server's DB)
ADMIN_USERNAMES=
